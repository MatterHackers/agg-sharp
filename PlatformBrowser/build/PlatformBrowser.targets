<Project>

  <!--
    Delivers the browser host's JS modules (wwwroot/frameLoop.js, wwwroot/input.js)
    to whatever builds against this project.

    Modeled on WebGpu/native/WgpuNative.targets, which is this repo's precedent for a
    library shipping a build asset: the project imports its own .targets, and the
    items are added BeforeTargets="AssignTargetPaths" so they flow transitively -
    GetCopyToOutputDirectoryItems (how a referencing project picks up a reference's
    content) depends on AssignTargetPaths, so an item added there is visible to
    consumers as well as to this project's own output.

    A Blazor WebAssembly head needs one more thing, settled by examples/BrowserHost
    (W3 S5): it serves only what is in the static web assets manifest, and files that
    merely land in bin/.../wwwroot are not in it. So the head IMPORTS this file itself
    (see BrowserHost.csproj) - a ProjectReference delivers a reference's content to the
    consumer's output folder, not into its item lists, and DefineStaticWebAssets reads
    @(Content) from the consuming project's own evaluation. That is why the target below
    also runs before ResolveProjectStaticWebAssets, and why each item carries ContentRoot:
    without it the assets are attributed to the head's own wwwroot, where these files do
    not exist, and the page gets a 200 with an empty body. No Razor-SDK flavour of this
    project and no hand-written StaticWebAsset items were needed.

    Opt out entirely with -p:PlatformBrowserSkipJsDelivery=true (a consumer that
    vendors its own copies of the modules).
  -->

  <PropertyGroup>
    <PlatformBrowserRoot>$(MSBuildThisFileDirectory)../</PlatformBrowserRoot>
    <!-- Normalized because it is handed to the static web assets pipeline as a content root, and that is
         compared against other roots as a string: "PlatformBrowser/build/../wwwroot/" would be a second,
         different root for the same folder. -->
    <PlatformBrowserWwwRoot>$([MSBuild]::NormalizeDirectory('$(PlatformBrowserRoot)wwwroot'))</PlatformBrowserWwwRoot>

    <!-- Where the files land relative to the consuming app's web root. The host page
         awaits BrowserHostBootstrap.InitializeAsync, which imports them from the app
         root (its ModuleBasePath is "../", relative to _framework/), so app-root is
         the default. A head that serves them from somewhere else sets both this and
         ModuleBasePath. -->
    <PlatformBrowserJsTargetFolder Condition="'$(PlatformBrowserJsTargetFolder)' == ''">wwwroot</PlatformBrowserJsTargetFolder>
  </PropertyGroup>

  <Target Name="_PlatformBrowserIncludeJsModules"
          BeforeTargets="AssignTargetPaths;ResolveProjectStaticWebAssets"
          Condition="'$(PlatformBrowserSkipJsDelivery)' != 'true'">
    <ItemGroup>
      <PlatformBrowserJsModule Include="$(PlatformBrowserWwwRoot)*.js" />

      <Content Include="@(PlatformBrowserJsModule)">
        <ContentRoot>$(PlatformBrowserWwwRoot)</ContentRoot>
        <Link>$(PlatformBrowserJsTargetFolder)/%(Filename)%(Extension)</Link>
        <TargetPath>$(PlatformBrowserJsTargetFolder)/%(Filename)%(Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Visible>false</Visible>
      </Content>
    </ItemGroup>
  </Target>

</Project>
