<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Deliberately still Windows only, unlike the other demos. This spike exists to prove the raw HWND
         swapchain path with nothing from agg in the way, so it hosts itself in a WinForms Form and pumps
         messages through user32 PeekMessage. The macOS equivalent - a CAMetalLayer surface on an AppKit
         window - is already proven by PlatformMac and HelloWorld, so porting this would only duplicate
         PlatformMac inside a demo whose whole point is to depend on nothing. Building it on macOS needs
         -p:EnableWindowsTargeting=true and produces something that cannot run here. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>MatterHackers.WebGpu.Example</RootNamespace>
    <StartupObject>MatterHackers.WebGpu.Example.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deliberately only the raw binding: this spike proves the HWND surface path works with nothing
         from agg in the way. -->
    <ProjectReference Include="..\..\WebGpu\MatterHackers.WebGpu.csproj" />
  </ItemGroup>

</Project>
