<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>MatterHackers.WebGpu.Example</RootNamespace>
    <StartupObject>MatterHackers.WebGpu.Example.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deliberately only the raw binding: this spike proves the HWND surface path works with nothing
         from agg in the way. -->
    <ProjectReference Include="..\..\WebGpu\MatterHackers.WebGpu.csproj" />
  </ItemGroup>

</Project>
