<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<!-- The graduated shell of spikes/WebGpuWasmSpike: the smallest possible consumer of
	     PlatformBrowser, here to prove that the browser host packages, resolves its providers, boots,
	     ticks, translates input and PAINTS in a real browser. It is not a product, and it deliberately
	     knows nothing about MatterCAD.

	     A plain `dotnet build` and `dotnet run` still work with no wasm-tools workload installed:
	     WebGpuBrowser.targets only turns on the native link when -p:LinkEmdawnWebGpu=true is passed, and
	     without it the WebGPU DllImports are unbacked and the first device call throws - the right
	     failure for a build that never asked for the link. Nothing else here may add a
	     NativeFileReference or turn on WasmBuildNative/AOT unconditionally. -->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>MatterHackers.Agg.Examples</RootNamespace>
		<Company>MatterHackers Inc.</Company>
		<!-- The [JSExport] on the demo's screenshot hook: the interop generator emits unsafe marshalling
		     code, so the switch is required for a single attribute (SYSLIB1075). Same reason
		     PlatformBrowser has it. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
		<!-- Only so `dotnet run` has a static file server to serve the app out of; never published. -->
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- The one reference the host needs. Agg, Gui and VectorMath arrive transitively, and so do the
		     three JS modules - build/PlatformBrowser.targets hands them over as Content, which is exactly
		     what this project exists to validate. -->
		<ProjectReference Include="..\..\PlatformBrowser\PlatformBrowser.csproj" />
	</ItemGroup>

	<Import Project="..\..\PlatformBrowser\build\PlatformBrowser.targets" />

	<!-- The browser leg of the wgpu bootstrap. Two jobs, and this project needs both: it links
	     emdawnwebgpu when asked to (-p:LinkEmdawnWebGpu=true, which is how this example is published for
	     a real paint), and it always filters this machine's desktop wgpu-native shared library back out
	     of the build and publish output - PlatformBrowser reaches MatterHackers.WebGpu now, whose own
	     bootstrap stages that library and flows it here. See the file. -->
	<Import Project="..\..\WebGpu\build\WebGpuBrowser.targets" />

</Project>
