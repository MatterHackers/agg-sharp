<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<config>
		<!-- 
    Used to specify the default location to expand packages.
    See: NuGet.exe help install
    See: NuGet.exe help update
    -->
		<add key="repositorypath" value="../../packages" />
	</config>
	<packageSources>
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<!-- No machine-specific sources here: a local source that does not exist
		     fails restore with NU1301 on every other machine, including CI. To test
		     an unpublished ManifoldRust build, add C:\Development\LocalNuGet to your
		     user-level NuGet.Config (%APPDATA%\NuGet\NuGet.Config) instead. -->
	</packageSources>
</configuration>