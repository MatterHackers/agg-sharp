<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Deliberately net10.0 and NOT net10.0-macos: the macOS TFM drags in the whole
		     Xamarin/MonoMac binding stack and its workload. Everything AppKit here is raw
		     objc_msgSend P/Invoke, so a plain TFM is all that is needed - and it keeps this
		     assembly restorable on a machine with no macOS workload installed. -->
		<TargetFramework>net10.0</TargetFramework>
		<Company>MatterHackers Inc.</Company>
		<AssemblyName>agg_platform_mac</AssemblyName>
		<RootNamespace>agg_platform_mac</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>TRACE;DEBUG</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>TRACE;RELEASE</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<!-- The modifier-flag translation is pure and worth testing without a window, and the AppKit
		     constants it is driven by are internal ABI values the tests need to name. -->
		<InternalsVisibleTo Include="Agg.Tests" />
	</ItemGroup>
	<ItemGroup>
		<!-- The same set PlatformWin32 pulls in, minus anything WinForms. No PackageReferences at
		     all: this assembly must be buildable with zero NuGet dependencies of its own. -->
		<ProjectReference Include="..\agg\Agg.csproj" />
		<ProjectReference Include="..\GuiAutomation\GuiAutomation.csproj" />
		<ProjectReference Include="..\Gui\Gui.csproj" />
		<ProjectReference Include="..\ImageProcessing\ImageProcessing.csproj" />
		<ProjectReference Include="..\RenderCore\RenderCore.csproj" />
		<ProjectReference Include="..\RenderGl\RenderGl.csproj" />
		<!-- Also what carries libwgpu_native.dylib into the output of every app that hosts a window. -->
		<ProjectReference Include="..\WebGpuRender\WebGpuRender.csproj" />
		<ProjectReference Include="..\VectorMath\VectorMath.csproj" />
	</ItemGroup>
</Project>
