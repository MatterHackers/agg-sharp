<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MatterHackers.WebGpu</RootNamespace>
    <Company>MatterHackers Inc.</Company>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Generated 1:1 bindings keep the C names (camelCase fields, wgpu* methods) on purpose. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- This folder also holds the hand-run binding generator; compile only the generated
         binding rather than sweeping the generator's sources (and build output) in. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The shared Emscripten cache that build/WebGpuBrowser.targets seeds is ~1700 files and 215 MB
         of derived output living inside this project's folder. Excluded from the default item globs
         rather than Removed afterwards, so a desktop build never even enumerates it. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Browser/emscripten-cache/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Generated\*.cs" />

    <!-- Hand written types for webgpu.h flavours the generator does not see, currently the
         browser's emdawnwebgpu extensions. Kept out of Generated\ so re-generating cannot
         clobber them. -->
    <Compile Include="Browser\**\*.cs" />

    <!-- The bootstrap's cache and staging output are ~75 MB of release zips and shared
         libraries. Keep the default None glob out of them; the one file that matters is
         added with copy metadata by native/WgpuNative.targets. -->
    <None Remove="native\downloads\**" />
    <None Remove="native\staging\**" />
  </ItemGroup>

  <!-- Downloads, verifies and stages the pinned wgpu-native shared library for this
       machine's platform on first build, then copies it next to the output (and to
       anything that references this project). No feed, no credentials, no script. -->
  <Import Project="native/WgpuNative.targets" />

</Project>
